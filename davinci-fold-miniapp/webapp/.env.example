# Required — URL of the davinci-fold backend
VITE_DAVINCI_FOLD_URL=https://dress-oklahoma-beans-shuttle.trycloudflare.com

# Required — HS256 JWT with role:"admin" for election creation
VITE_ADMIN_JWT=

# Required — URL of the Vocdoni census service (e.g. sequencer census endpoint)
# Used to publish the address-based Merkle census and retrieve voter proofs
VITE_CENSUS_SERVICE_URL=

# Required — Base URL where ballot circuit files (*.wasm, *.zkey) are hosted
# Used by snarkjs to generate the Groth16 ballot proof client-side
VITE_CIRCUIT_URL=

# Required — URL of the ballot verification key JSON matching the fold circuit
VITE_ELECTION_VK_URL=

# Required — ElGamal public key for the election (X and Y field element coordinates, 0x-prefixed BE hex)
VITE_ENC_X=
VITE_ENC_Y=

# Required — Ballot mode hex string matching the fold circuit configuration
VITE_BALLOT_MODE=

# Optional — WalletConnect project ID (needed when no browser extension wallet is detected)
VITE_WALLETCONNECT_PROJECT_ID=
